# ─── Application ────────────────────────────────────────────────
APP_ENV=development
APP_SECRET_KEY=change-me-in-production-use-a-long-random-string

# ─── Database ────────────────────────────────────────────────────
DATABASE_URL=postgresql://photouser:photopass@db:5432/photodb

# ─── Redis ───────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ─── Auth (JWT) ──────────────────────────────────────────────────
JWT_SECRET=change-me-jwt-secret-long-random-string
JWT_ACCESS_EXPIRY=900       # seconds (15 min)
JWT_REFRESH_EXPIRY=604800   # seconds (7 days)

# ─── Admin Seed User ─────────────────────────────────────────────
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-admin-password

# ─── AI / LLM — Groq (primary) ───────────────────────────────────
AI_PROVIDER=groq
GROQ_API_KEY=gsk_YOUR_GROQ_KEY_HERE
AI_MODEL_STAGE1=qwen/qwen3.8-27b
AI_MODEL_STAGE2=openai/gpt-oss-120b

# ─── Embeddings — OpenAI (always used for embeddings) ────────────
OPENAI_API_KEY=sk-YOUR_OPENAI_KEY_HERE
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small

# ─── Fallback LLM Providers (optional) ───────────────────────────
# ANTHROPIC_API_KEY=YOUR_ANTHROPIC_KEY_HERE
# GOOGLE_API_KEY=YOUR_GOOGLE_KEY_HERE

# ─── Ingestion ───────────────────────────────────────────────────
BATCH_SIZE=100
MAX_RECORDS_PER_RUN=5000
INGESTION_RATE_LIMIT_RPM=60

# ─── Apify Connector (Reddit Scraping) ───────────────────────────
APIFY_API_TOKEN=YOUR_APIFY_API_TOKEN
APIFY_REDDIT_ACTOR=trudax/reddit-scraper

# ─── YouTube Data API v3 ─────────────────────────────────────────
YOUTUBE_API_KEY=YOUR_YOUTUBE_API_KEY

# ─── Legacy Reddit API (Deprecated, Apify is used instead) ───────
REDDIT_CLIENT_ID=YOUR_REDDIT_CLIENT_ID
REDDIT_CLIENT_SECRET=YOUR_REDDIT_CLIENT_SECRET
REDDIT_USER_AGENT=PhotoDiscoveryEngine/1.0

# ─── Clustering ──────────────────────────────────────────────────
CLUSTERING_ALGORITHM=dbscan
CLUSTER_MIN_SAMPLES=5
CLUSTER_EPSILON=0.3

# ─── Thresholds ──────────────────────────────────────────────────
RELEVANCE_THRESHOLD=0.7
CONFIDENCE_THRESHOLD=0.6
EMERGING_PROBLEM_GROWTH_THRESHOLD=0.25
DEDUP_SIMILARITY_THRESHOLD=0.95

# ─── Retention ───────────────────────────────────────────────────
DATA_RETENTION_DAYS=365

# ─── Frontend ────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=change-me-nextauth-secret
