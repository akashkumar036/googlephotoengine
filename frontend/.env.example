# Vercel / Frontend Environment Variables

# The public HTTPS URL where your backend FastAPI server is hosted
NEXT_PUBLIC_API_URL=https://api.yourdomain.com

# The canonical production URL of your Vercel deployment
NEXTAUTH_URL=https://your-photo-discovery-app.vercel.app

# A random 32+ character secret for NextAuth JWT encryption (generate with: openssl rand -hex 32)
NEXTAUTH_SECRET=your-random-production-secret-here-at-least-32-chars
